{
  "name": "ironlog",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:generate": "drizzle-kit generate",
    "verify": "npm run typecheck && npm run lint && npm test",
    "bundle": "expo export --platform android --output-dir dist",
    "lint:fix": "eslint . --fix",
    "art:template": "tsx scripts/build-muscle-template.ts",
    "db:exercises": "tsx scripts/build-exercise-db.ts",
    "media:stage": "tsx scripts/stage-media.ts",
    "media:compress": "tsx scripts/compress-media.ts"
  },
  "dependencies": {
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@shopify/react-native-skia": "2.6.2",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.18",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.15",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.2",
    "expo-keep-awake": "~57.0.1",
    "expo-notifications": "~57.0.15",
    "expo-screen-orientation": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-video": "~57.0.3",
    "mobx": "^7.0.3",
    "mobx-react-lite": "^5.0.3",
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-body-highlighter": "^3.2.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "victory-native": "^42.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "^57.0.9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "jest": "^30.5.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
